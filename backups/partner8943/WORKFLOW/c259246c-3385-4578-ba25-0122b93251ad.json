      "type": "IDENTITY"
    },
    "definition": {
      "start": "Interactive Form",
      "steps": {
        "Compare Strings": {
          "actionId": "sp:compare-strings",
          "choiceList": [
            {
              "comparator": "StringEquals",
              "nextStep": "HTTP Request",
              "variableA.$": "$.form.formData.decision",
              "variableB": "APPROVED"
            }
          ],
          "defaultStep": "Interactive Message",
          "displayName": "",
          "type": "choice"
        },
        "End Step - Failure": {
          "actionId": "sp:operator-failure",
          "description": null,
          "displayName": "",
          "failureDetails": "The account creation request could not be submitted to SailPoint.",
          "failureName": "SL Account Creation Request Failed",
          "type": "failure"
        },
        "End Step - Success": {
          "actionId": "sp:operator-success",
          "displayName": "",
          "type": "success"
        },
        "End Step - Success 1": {
          "actionId": "sp:operator-success",
          "displayName": "",
          "type": "success"
        },
        "Form": {
          "actionId": "sp:forms",
          "attributes": {
            "deadline": "7d",
            "expirationBody": "<p>Hello {{$.getIdentity.attributes.displayName}},</p>\n<p>The approval request for the following SL user has expired.</p>\n<p>User: {{$.interactiveForm.formData.firstName}} {{$.interactiveForm.formData.lastName}}<br>User ID: {{$.interactiveForm.formData.userId}}</p>\n<p>The request has not been approved and no user account has been created.</p>",
            "formDefinitionId": "a17f6719-50be-4c48-97e4-70466c20e771",
            "inputForForm_email.$": "$.interactiveForm.formData.emailField",
            "inputForForm_firstName.$": "$.interactiveForm.formData.firstName",
            "inputForForm_lastName.$": "$.interactiveForm.formData.lastName",
            "inputForForm_managerName.$": "$.getIdentity.attributes.displayName",
            "inputForForm_nifNie.$": "$.interactiveForm.formData.nifNie",
            "inputForForm_userId.$": "$.interactiveForm.formData.userId",
            "notificationBody": "<p>Hello {{$.getIdentity.attributes.displayName}},</p>\n<p>A new SL user creation request requires your approval.</p>\n<p>User: {{$.interactiveForm.formData.firstName}} {{$.interactiveForm.formData.lastName}}<br>User ID: {{$.interactiveForm.formData.userId}}</p>\n<p>Please review the user information and approve or reject the request using the form below.</p>\n<p>Thank you.</p>",
            "notificationSubject": "SL User Creation - Manager Approval Required",
            "recipient.$": "$.interactiveForm.formData.manager",
            "reminder": "3d",
            "reminderBody": "<p>Hello {{$.getIdentity.attributes.displayName}},</p>\n<p>This is a reminder that the following SL user creation request is waiting for your approval.</p>\n<p>User: {{$.interactiveForm.formData.firstName}} {{$.interactiveForm.formData.lastName}}<br>User ID: {{$.interactiveForm.formData.userId}}</p>\n<p>Please approve or reject the request before the submission deadline.</p>\n<p>Thank you.</p>"
          },
          "description": "Manager approval for user creation",
          "displayName": "",
          "nextStep": "Compare Strings",
          "type": "action",
          "versionNumber": 1
        },
        "Get Identity": {
          "actionId": "sp:get-identity",
          "attributes": {
            "id.$": "$.interactiveForm.formData.manager"
          },
          "description": null,
          "displayName": "Get Identity (Manager)",
          "nextStep": "Form",
          "type": "action",
          "versionNumber": 2
        },
        "HTTP Request": {
          "actionId": "sp:http",
          "attributes": {
            "jsonRequestBody": {
              "attributes": {
                "NIF": "{{$.interactiveForm.formData.nifNie}}",
                "apellido": "{{$.interactiveForm.formData.lastName}}",
                "correo": "{{$.interactiveForm.formData.emailField}}",
                "id": "{{$.interactiveForm.formData.userId}}",
                "manager": "{{$.getIdentity.attributes.uid}}",
                "nombre": "{{$.interactiveForm.formData.firstName}}",
                "sourceId": "a57560a1baaa487f81ec2acfae52d0c0"
              }
            },
            "method": "post",
            "param_authenticationRef": "oauth",
            "param_oauth": {
              "mapping": {
                "auth_client_id": "clientId",
                "auth_client_secret": "clientSecret",
                "auth_credential_location": "credentialLocation",
                "auth_token_url": "tokenURL"
              },
              "paramID": "e73423ac-6e4a-4947-b354-777875570dc4",
              "paramType": "1.4",
              "refID": "d51c6d39-33ca-42c3-91d7-f404667c3c23"
            },
            "requestContentType": "json",
            "url": "https://partner8943.api.identitynow-demo.com/accounts/v1"
          },
          "catch": [
            {
              "next": "End Step - Failure"
            }
          ],
          "description": "Submits an account creation request to SailPoint.",
          "displayName": "",
          "nextStep": "End Step - Success",
          "type": "action",
          "versionNumber": 3
        },
        "Interactive Form": {
          "actionId": "sp:interactive-form",
          "attributes": {
            "formDefinitionId": "28679c62-d61e-4df3-82c3-9293380f11fc",
            "interactiveProcessId.$": "$.trigger.interactiveProcessId",
            "message": "<p>Complete the form to continue&nbsp;</p>",
            "ownerId.$": "$.trigger.launchedBy.id",
            "title": "Interactive Form"
          },
          "description": "Interactive Form",
          "displayName": "InteractiveForm",
          "nextStep": "Get Identity",
          "type": "action",
          "versionNumber": 1
        },
        "Interactive Message": {
          "actionId": "sp:interactive-message",
          "attributes": {
            "category": "WARN",
            "interactiveProcessId.$": "$.trigger.interactiveProcessId",
            "message": "<p>The user creation was not approved. No account has been created.</p>",
            "ownerId.$": "$.trigger.launchedBy.id",
            "title": "Request not approved"
          },
          "displayName": "",
          "nextStep": "End Step - Success 1",
          "type": "action",
          "versionNumber": 1
        }
      }
    },
    "description": "Workflow to register new SL users through an interactive form.",
