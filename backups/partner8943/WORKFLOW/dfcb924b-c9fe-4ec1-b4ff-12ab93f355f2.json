      "type": "IDENTITY"
    },
    "definition": {
      "start": "Get List of Identities",
      "steps": {
        "End Step - Success 2": {
          "displayName": "",
          "type": "success"
        },
        "Get List of Identities": {
          "actionId": "sp:get-identities",
          "attributes": {
            "inputQuery": "attributes.dni:{{$.trigger.attributes.dni}}",
            "searchBy": "searchQuery"
          },
          "displayName": "",
          "nextStep": "Loop",
          "type": "action",
          "versionNumber": 2
        },
        "Loop": {
          "actionId": "sp:loop:iterator",
          "attributes": {
            "context.$": "$",
            "input.$": "$.getListOfIdentities.identities",
            "start": "Get Identity",
            "steps": {
              "Compare Strings": {
                "choiceList": [
                  {
                    "comparator": "StringEquals",
                    "nextStep": "End Step - Success 1",
                    "variableA.$": "$.trigger.identity.name",
                    "variableB.$": "$.getIdentity.name"
                  }
                ],
                "defaultStep": "Send Email 1",
                "displayName": "",
                "type": "choice"
              },
              "End Step - Success": {
                "displayName": "",
                "type": "success"
              },
              "End Step - Success 1": {
                "displayName": "",
                "type": "success"
              },
              "Get Identity": {
                "actionId": "sp:get-identity",
                "attributes": {
                  "id.$": "$.loop.loopInput.id"
                },
                "displayName": "",
                "nextStep": "Compare Strings",
                "type": "action",
                "versionNumber": 2
              },
              "Send Email 1": {
                "actionId": "sp:send-email",
                "attributes": {
                  "body": "<p>Se ha creado la identidad \"{$.trigger.identity.name}\" con tu mismo DNI.</p>",
                  "context": {},
                  "recipientEmailList.$": "$.getIdentity.attributes.email",
                  "subject": "Se ha creado una identidad con tu mismo DNI"
                },
                "displayName": "",
                "nextStep": "End Step - Success",
                "type": "action",
                "versionNumber": 2
              }
            }
          },
          "displayName": "",
          "nextStep": "End Step - Success 2",
          "type": "action",
          "versionNumber": 1
        }
      }
    },
    "description": "Si se crea una identidad se busca las identidades activas que tengan el mismo dni que la creada y mandar un email",
