{
  "jwsHeader": null,
  "jwsSignature": null,
  "object": {
    "created": "2026-06-09T08:01:39.087879085Z",
    "creator": {
      "id": "1dff61379fdc41fbac00c7f5ae992e23",
      "name": "cjoglar",
      "type": "IDENTITY"
    },
    "definition": {
      "start": "Define Variable",
      "steps": {
        "Check for READER Profile": {
          "actionId": "sp:loop:iterator",
          "attributes": {
            "input.$": "$.getAccess.accessItems",
            "loopInput.$": "$.getAccess",
            "start": "Compare Profile Name",
            "steps": {
              "Compare Profile Name": {
                "actionId": "sp:compare-strings",
                "choiceList": [
                  {
                    "comparator": "StringEquals",
                    "nextStep": "Remove READER Access",
                    "variableA.$": "$.loop.loopInput.name",
                    "variableB": "READER"
                  }
                ],
                "defaultStep": "End Loop Step",
                "description": "Check if current item is READER profile",
                "displayName": "Is READER Profile",
                "type": "choice"
              },
              "End Loop Step": {
                "actionId": "sp:operator-success",
                "displayName": "End Loop",
                "type": "success"
              },
              "Remove READER Access": {
                "actionId": "sp:access:manage",
                "attributes": {
                  "comments": "Removing READER access profile because SCANNER was assigned",
                  "removeIdentities.$": "$.trigger.identity.id",
                  "requestType": "REVOKE_ACCESS",
                  "requestedItems": {
                    "accessItems": [
                      {
                        "id.$": "$.loop.loopInput.id",
                        "name.$": "$.loop.loopInput.name",
                        "type": "accessprofile"
                      }
                    ]
                  }
                },
                "displayName": "Remove READER Profile",
                "nextStep": "End Loop Step",
                "type": "action",
                "versionNumber": 1
              }
            }
          },
          "displayName": "Loop Through Access Items",
          "nextStep": "End Step - Success",
          "type": "action",
          "versionNumber": 1
        },
        "Compare Strings": {
          "actionId": "sp:compare-strings",
          "choiceList": [
            {
              "comparator": "StringEquals",
              "nextStep": "Get Access",
              "variableA.$": "$.defineVariable.test",
              "variableB": "APPROVED"
            }
          ],
          "defaultStep": "End Step - Success",
          "displayName": "",
          "type": "choice"
        },
        "Define Variable": {
          "actionId": "sp:define-variable",
          "attributes": {
            "id": "sp:define-variable",
            "variables": [
              {
                "description": "",
                "name": "test",
                "transforms": [],
                "variableA.$": "$.trigger.requestedItemsStatus[?(@.name == \"SCANNER\" && @.operation == \"Add\")].approvalInfo[0].approvalDecision"
              }
            ]
          },
          "displayName": "",
          "nextStep": "Compare Strings",
          "type": "Mutation"
        },
        "End Step - Success": {
          "actionId": "sp:operator-success",
          "displayName": "Workflow Complete",
          "type": "success"
        },
        "Get Access": {
          "actionId": "sp:access:get",
          "attributes": {
            "accessprofiles": true,
            "entitlements": false,
            "getAccessBy": "specificIdentity",
            "identityToReturn.$": "$.trigger.identity.id",
            "roles": false
          },
          "displayName": "Get Current Access",
          "nextStep": "Check for READER Profile",
          "type": "action",
          "versionNumber": 1
        }
      }
    },
    "description": "Automatically removes the READER access profile when the SCANNER access profile is assigned to an identity",
    "enabled": false,
    "id": "18a1d7ed-adf4-41f2-beaf-388c28b78121",
    "modified": "2026-06-09T08:52:54.157414268Z",
    "modifiedBy": {
      "id": "1dff61379fdc41fbac00c7f5ae992e23",
      "name": "cjoglar",
      "type": "IDENTITY"
    },
    "name": "Remove READER Access Profile When SCANNER is Assigned",
    "owner": {
      "id": "1dff61379fdc41fbac00c7f5ae992e23",
      "name": "cjoglar",
      "type": "IDENTITY"
    },
    "trigger": {
      "attributes": {
        "filter.$": "$.requestedItemsStatus[?(@.name == \"SCANNER\" && @.operation == \"Add\")].approvalInfo[?(@.approvalDecision == \"APPROVED\")]",
        "id": "idn:access-request-post-approval",
        "integrationId": null
      },
      "mode": "advanced",
      "type": "EVENT"
    }
  },
  "self": {
    "id": "18a1d7ed-adf4-41f2-beaf-388c28b78121",
    "name": "Remove READER Access Profile When SCANNER is Assigned",
    "type": "WORKFLOW"
  },
  "version": 1
}
