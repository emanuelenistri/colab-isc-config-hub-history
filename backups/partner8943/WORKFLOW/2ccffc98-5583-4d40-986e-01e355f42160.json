        },
        "Loop": {
          "actionId": "sp:loop:iterator",
          "attributes": {
            "context.$": "{{$.trigger.changes[?(@.attribute == \"email\")].newValue}}",
            "input.$": "$.getListOfIdentities.identities",
            "start": "Get Identity",
            "steps": {
              "Compare Strings": {
                "choiceList": [
                  {
                    "comparator": "StringEquals",
                    "nextStep": "Send Email 1",
                    "variableA.$": "$.loop.loopInput.attributes.email",
                    "variableB.$": "$.context.attributes.email"
                  }
                ],
                "defaultStep": "End Step - Success",
                "displayName": "Comparar Emails",
                "type": "choice"
              },
              "End Step - Success": {
                "displayName": "Terminar Iteración",
                "type": "success"
              },
              "Get Identity": {
                "actionId": "sp:get-identity",
                "attributes": {
                  "id.$": "$.loop.loopInput.id"
                },
                "displayName": "Obtener Identidad Iterada",
                "nextStep": "Compare Strings",
                "type": "action",
                "versionNumber": 2
              },
              "Send Email 1": {
                "actionId": "sp:send-email",
                "attributes": {
                  "body": "<p>Se encontró un email duplicado: {{$.context.attributes.email}}</p>",
                  "context": {},
                  "recipientEmailList": [
                    "dmedinay@sia.es"
                  ],
                  "subject": "Email Duplicado"
                },
                "displayName": "Enviar Notificación",
                "nextStep": "End Step - Success",
                "type": "action",
                "versionNumber": 2
              }
            }
          },
          "displayName": "Iterar Sobre Identidades",
          "nextStep": "End Step - Success 2",
          "type": "action",
          "versionNumber": 1
        },
        "Send Email 2": {
          "actionId": "sp:send-email",
