    "definition": {
      "start": "Compare Number of Changes",
      "steps": {
        "Compare Number of Changes": {
          "choiceList": [
            {
              "comparator": "NumericGreaterThan",
              "nextStep": "Send Alert Email",
              "variableA.$": "$.trigger.stats.changed",
              "variableB": 30
            }
          ],
          "defaultStep": "End Step - Success",
          "type": "choice"
        },
        "End Step - Failure": {
          "attributes": {
            "message": "Aggregation stopped due to exceeding 30 changes threshold",
            "name": "Aggregation Stopped"
          },
          "displayName": "",
          "type": "failure"
        },
        "End Step - Success": {
          "displayName": "",
          "type": "success"
        },
        "Send Alert Email": {
          "actionId": "sp:send-email",
          "attributes": {
            "body": "Aggregation on source ${sourceName} has been flagged because more than 30 changes were detected. Total changes: ${changedCount}. Please review the aggregation results.",
            "context": {
              "changedCount.$": "$.trigger.stats.changed",
              "sourceName.$": "$.trigger.source.name"
            },
            "recipientEmailList": "admin@company.com",
            "subject": "Alert: Aggregation Exceeded Change Threshold"
          },
          "displayName": "",
          "nextStep": "End Step - Failure",
          "type": "action",
          "versionNumber": 2
        }
      }
    },
    "description": "Monitors account aggregation completion and stops the aggregation if more than 30 changes are detected",
