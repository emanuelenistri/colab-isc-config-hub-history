    },
    "trigger": {
      "attributes": {
        "id": "idn:access-request-trigger",
        "integrationId": null
      },
      "type": "AccessRequestTrigger"
    }
  },
  "self": {
    "id": "0c343a4d-0eaa-4c20-980b-098c8d2205ea",
    "name": "Template: Quorum Based Approval of Access Request",
    "type": "WORKFLOW"
  },
