    "definition": {
      "start": "Get List of Identities",
      "steps": {
        "End Step - Success 1": {
          "displayName": "",
          "type": "success"
        },
        "Get List of Identities": {
          "actionId": "sp:get-identities",
          "attributes": {
            "inputQuery": "name:Hugo_Diaz_345",
            "searchBy": "searchQuery"
          },
          "displayName": "",
          "nextStep": "Loop",
          "type": "action",
          "versionNumber": 2
        },
        "Loop": {
          "actionId": "sp:loop:iterator",
          "attributes": {
            "context.$": "$",
            "input.$": "$.getListOfIdentities.identities",
            "start": "Get Identity",
            "steps": {
              "End Step - Success": {
                "displayName": "",
                "type": "success"
              },
              "Get Accounts": {
                "actionId": "sp:get-accounts",
                "attributes": {
                  "filterCriteria": "name",
                  "getAccountsBy": "specificIdentity",
                  "identity.$": "$.getIdentity.id",
                  "operator": "eq",
                  "value": "$.trigger.results.resultItemList[*].title"
                },
                "description": "This action identifies the appropriate account data for the listed accounts provided by the SaaS Management report.",
                "nextStep": "Manage Accounts",
                "type": "action",
                "versionNumber": 1
              },
              "Get Identity": {
                "actionId": "sp:get-identity",
                "attributes": {
                  "id.$": "$.loop.loopInput.id"
                },
                "displayName": "",
                "nextStep": "Get Accounts",
                "type": "action",
                "versionNumber": 2
              },
              "Manage Accounts": {
                "actionId": "sp:manage-account",
                "attributes": {
                  "accountIds.$": "$.getAccounts.accounts[*].id",
                  "operation": "enable"
                },
                "description": "This action deprovisions all accounts returned by the Get Accounts step to help eliminate risk and license costs for inactive accounts.",
                "nextStep": "End Step - Success",
                "type": "action",
                "versionNumber": 1
              }
            }
          },
          "displayName": "",
          "nextStep": "End Step - Success 1",
          "type": "action",
          "versionNumber": 1
        }
      }
    },
    "description": "This workflow is triggered by a SaaS Management report generated for accounts with zero days of activity over 90 days from initial activation. This workflow will deprovision those accounts to reduce risk and license costs.",
