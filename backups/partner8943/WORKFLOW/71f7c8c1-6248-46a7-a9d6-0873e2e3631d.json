{
  "jwsHeader": null,
  "jwsSignature": null,
  "object": {
    "created": "2024-11-27T12:00:01.342271264Z",
    "creator": {
      "id": "d024cdc01088491194e571464f97b308",
      "name": "dmedinay",
      "type": "IDENTITY"
    },
    "definition": {
      "start": "Define Variable",
      "steps": {
        "Compare Numbers": {
          "choiceList": [
            {
              "comparator": "NumericGreaterThan",
              "nextStep": "Send Email",
              "variableA.$": "$.getListOfIdentities.identities.length()",
              "variableB": 0
            }
          ],
          "defaultStep": "End Step - Success",
          "displayName": "",
          "type": "choice"
        },
        "Define Variable": {
          "attributes": {
            "id": "sp:define-variable",
            "variables": [
              {
                "description": "",
                "name": "Variable nuevo email",
                "transforms": [],
                "variableA.$": "$.trigger.changes[?(@.attribute === \"email\")].newValue"
              }
            ]
          },
          "displayName": "Variable nuevo email",
          "nextStep": "Define Variable 1",
          "type": "Mutation"
        },
        "Define Variable 1": {
          "attributes": {
            "id": "sp:define-variable",
            "variables": [
              {
                "description": "",
                "name": "variable @",
                "transforms": [
                  {
                    "id": "sp:transform:getIndex:int",
                    "input": {
                      "pattern": "@"
                    }
                  }
                ],
                "variableA.$": "$.defineVariable.variableNuevoEmail"
              }
            ]
          },
          "displayName": "Variable @",
          "nextStep": "Define Variable 2",
          "type": "Mutation"
        },
        "Define Variable 2": {
          "attributes": {
            "id": "sp:define-variable",
            "variables": [
              {
                "description": "",
                "name": "Variable alias",
                "transforms": [
                  {
                    "id": "sp:transform:substring:string",
                    "input": {
                      "length.$": "$.defineVariable1[\"variable @\"]",
                      "start": 0
                    }
                  }
                ],
                "variableA.$": "$.defineVariable.variableNuevoEmail"
              }
            ]
          },
          "displayName": "Variable alias",
          "nextStep": "Define Variable 3",
          "type": "Mutation"
        },
        "Define Variable 3": {
          "attributes": {
            "id": "sp:define-variable",
            "variables": [
              {
                "description": "",
                "name": "Variable alias + cadena",
                "transforms": [
                  {
                    "id": "sp:transform:concatenate:string",
                    "input": {
                      "variableB": "@"
                    }
                  }
                ],
                "variableA.$": "$.defineVariable2.variableAlias"
              }
            ]
          },
          "displayName": "Variable alias + cadena",
          "nextStep": "Get List of Identities",
          "type": "Mutation"
        },
        "End Step - Success": {
          "displayName": "",
          "type": "success"
        },
        "End Step - Success 1": {
          "displayName": "",
          "type": "success"
        },
        "Get List of Identities": {
          "actionId": "sp:get-identities",
          "attributes": {
            "inputQuery": "attributes.email:{{$.defineVariable3[\"Variable alias + cadena\"]}}",
            "searchBy": "searchQuery"
          },
          "displayName": "Get List of Identities mismo email",
          "nextStep": "Compare Numbers",
          "type": "action",
          "versionNumber": 2
        },
        "Loop": {
          "actionId": "sp:loop:iterator",
          "attributes": {
            "input.$": "$.getListOfIdentities.identities",
            "start": "Get Identity",
            "steps": {
              "End Step - Success 2": {
                "displayName": "",
                "type": "success"
              },
              "Get Accounts": {
                "actionId": "sp:get-accounts",
                "attributes": {
                  "getAccountsBy": "specificIdentity",
                  "identity.$": "$.getIdentity.id"
                },
                "displayName": "",
                "nextStep": "Manage Accounts",
                "type": "action",
                "versionNumber": 1
              },
              "Get Identity": {
                "actionId": "sp:get-identity",
                "attributes": {
                  "id.$": "$.loop.loopInput.id"
                },
                "displayName": "",
                "nextStep": "Get Accounts",
                "type": "action",
                "versionNumber": 2
              },
              "Manage Accounts": {
                "actionId": "sp:manage-account",
                "attributes": {
                  "accountIds.$": "$.getAccounts.accounts[*].id",
                  "operation": "disable"
                },
                "displayName": "",
                "nextStep": "End Step - Success 2",
                "type": "action",
                "versionNumber": 1
              }
            }
          },
          "displayName": "",
          "nextStep": "End Step - Success 1",
          "type": "action",
          "versionNumber": 1
        },
        "Send Email": {
          "actionId": "sp:send-email",
          "attributes": {
            "body": "<p>El alias es: {{$.defineVariable2.variableAlias}}</p>\n<p>Hay&nbsp;{{$.getListOfIdentities.identities.length()}} identidades con ese alias.</p>\n<p>Las identidades con ese Alias son:{{$.getListOfIdentities.identities[*].name}}</p>",
            "context": {},
            "recipientEmailList": [
              "dmedinay@sia.es"
            ],
            "subject": "email duplicado"
          },
          "displayName": "",
          "nextStep": "Loop",
          "type": "action",
          "versionNumber": 2
        }
      }
    },
    "description": "Busca si el email de una identidad ya existe y envía una notificación si es necesario.",
    "enabled": false,
    "id": "71f7c8c1-6248-46a7-a9d6-0873e2e3631d",
    "modified": "2024-12-03T06:58:57.657753137Z",
    "modifiedBy": {
      "id": "d024cdc01088491194e571464f97b308",
      "name": "dmedinay",
      "type": "IDENTITY"
    },
    "name": "Validar Email Duplicado",
    "owner": {
      "id": "d024cdc01088491194e571464f97b308",
      "name": "dmedinay",
      "type": "IDENTITY"
    },
    "trigger": {
      "attributes": {
        "filter.$": "$.changes[?(@.attribute == \"email\")]",
        "filterDefinition": {
          "conditions": [
            {
              "operator": "==",
              "path": "attribute",
              "type": "string",
              "value": "email"
            }
          ],
          "logic": "and",
          "path": "changes"
        },
        "id": "idn:identity-attributes-changed",
        "integrationId": null
      },
      "mode": "basic",
      "type": "EVENT"
    }
  },
  "self": {
    "id": "71f7c8c1-6248-46a7-a9d6-0873e2e3631d",
    "name": "Validar Email Duplicado",
    "type": "WORKFLOW"
  },
  "version": 1
}
