    "trigger": {
      "attributes": {
        "filter.$": "$.changes[?(@.attribute == \"email\")]",
        "filterDefinition": {
          "conditions": [
            {
              "operator": "==",
              "path": "attribute",
              "type": "string",
              "value": "email"
            }
          ],
          "logic": "and",
          "path": "changes"
        },
