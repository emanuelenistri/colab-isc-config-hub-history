      "type": "IDENTITY"
    },
    "definition": {
      "start": "Define Variable 2",
      "steps": {
        "Compare Numbers": {
          "choiceList": [
            {
              "comparator": "NumericGreaterThan",
              "nextStep": "Send Email",
              "variableA.$": "$.getListOfIdentities.identities.length()",
              "variableB": 1
            }
          ],
          "defaultStep": "End Step - Success 2",
          "description": null,
          "displayName": "",
          "type": "choice"
        },
        "Define Variable": {
          "attributes": {
            "id": "sp:define-variable",
            "variables": [
              {
                "description": "",
                "name": "indice",
                "transforms": [
                  {
                    "id": "sp:transform:getIndex:int",
                    "input": {
                      "pattern": "@"
                    }
                  }
                ],
                "variableA.$": "$.defineVariable2.email"
              }
            ]
          },
          "displayName": "",
          "nextStep": "Define Variable 1",
          "type": "Mutation"
        },
        "Define Variable 1": {
          "attributes": {
            "id": "sp:define-variable",
            "variables": [
              {
                "description": "",
                "name": "alias",
                "transforms": [
                  {
                    "id": "sp:transform:substring:string",
                    "input": {
                      "length.$": "$.defineVariable.indice",
                      "start": 0
                    }
                  }
                ],
                "variableA.$": "$.defineVariable2.email"
              }
            ]
          },
          "displayName": "",
          "nextStep": "Define Variable 3",
          "type": "Mutation"
        },
        "Define Variable 2": {
          "attributes": {
            "id": "sp:define-variable",
            "variables": [
              {
                "description": "",
                "name": "email",
                "transforms": [],
                "variableA.$": "$.trigger.changes[?(@.attribute === \"email\")].newValue"
              }
            ]
          },
          "displayName": "",
          "nextStep": "Define Variable",
          "type": "Mutation"
        },
        "Define Variable 3": {
          "attributes": {
            "id": "sp:define-variable",
            "variables": [
              {
                "description": "",
                "name": "alias2",
                "transforms": [
                  {
                    "id": "sp:transform:concatenate:string",
                    "input": {
                      "variableB": "@"
                    }
                  }
                ],
                "variableA.$": "$.defineVariable1.alias"
              }
            ]
          },
          "displayName": "",
          "nextStep": "Define Variable 4",
          "type": "Mutation"
        },
        "Define Variable 4": {
          "attributes": {
            "id": "sp:define-variable",
            "variables": [
              {
                "description": "",
                "name": "identidades",
                "transforms": []
              }
            ]
          },
          "displayName": "",
          "nextStep": "Get List of Identities",
          "type": "Mutation"
        },
        "Define Variable 5": {
          "attributes": {
            "id": "sp:define-variable",
            "variables": [
              {
                "description": "",
                "name": "contador",
                "transforms": [],
                "variableA.$": "$.getListOfIdentities.identities.length()"
              }
            ]
          },
          "displayName": "",
          "nextStep": "Compare Numbers",
          "type": "Mutation"
        },
        "End Step - Success": {
          "displayName": "",
          "type": "success"
        },
        "End Step - Success 2": {
          "displayName": "",
          "type": "success"
        },
        "Get List of Identities": {
          "actionId": "sp:get-identities",
          "attributes": {
            "inputQuery": "attributes.email:{{$.defineVariable3.alias2}}",
            "searchBy": "searchQuery"
          },
          "displayName": "",
          "nextStep": "Loop",
          "type": "action",
          "versionNumber": 2
        },
        "Loop": {
          "actionId": "sp:loop:iterator",
          "attributes": {
            "context.$": "$",
            "input.$": "$.getListOfIdentities.identities",
            "start": "Get Identity",
            "steps": {
              "End Step - Success 1": {
                "displayName": "",
                "type": "success"
              },
              "Get Identity": {
                "actionId": "sp:get-identity",
                "attributes": {
                  "id.$": "$.loop.loopInput.id"
                },
                "description": null,
                "displayName": "",
                "nextStep": "End Step - Success 1",
                "type": "action",
                "versionNumber": 2
              }
            }
          },
          "displayName": "",
          "nextStep": "Define Variable 5",
          "type": "action",
          "versionNumber": 1
        },
        "Send Email": {
          "actionId": "sp:send-email",
          "attributes": {
            "body.$": "$.defineVariable5.contador",
            "context": {},
            "recipientEmailList": [
              "cjoglar@sia.es"
            ],
            "subject": "Prueba"
          },
          "displayName": "",
          "nextStep": "End Step - Success",
          "type": "action",
          "versionNumber": 2
        }
      }
    },
